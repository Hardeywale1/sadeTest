# ==========================================
# Sadé Frontend Environment Variables (.env)
# ==========================================

# Base API URL pointing to the Go backend
# For web browser on same machine: http://localhost:8080
# For mobile physical device testing: http://YOUR_LOCAL_IP:8080 (e.g., http://192.168.1.5:8080)
# For Netlify production: https://YOUR-CLOUD-RUN-SERVICE-URL
EXPO_PUBLIC_API_URL=http://localhost:8080

# Public frontend origin encoded into laboratory and pharmacy handoff QR codes.
# Web builds use the current browser origin when this is not set.
# EXPO_PUBLIC_APP_URL=https://your-sade-frontend.example
